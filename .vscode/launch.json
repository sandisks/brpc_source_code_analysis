{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug butil_demo (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/butil_cmake_lib/build/demo/butil_demo",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/butil_cmake_lib",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake-build"
        },
        {
            "name": "Debug butil_demo (Attach)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/butil_cmake_lib/build/demo/butil_demo",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
